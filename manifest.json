{
  "manifest_version": 3,
  "name": "AI Token Monitor",
  "version": "1.0.0",
  "description": "claude.aiとCodexのトークン使用量をリアルタイム監視",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/chat/*",
        "https://chatgpt.com/codex/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
